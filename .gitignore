# Root gitignore

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime files
node_modules/
dist/
dist-ssr/
*.local

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files
.env
*.env
.env.*

# Python cache
__pycache__/
*.py[cod]

# Backend and frontend build artifacts
/gestor-iot-frontend/node_modules/
/gestor-iot-frontend/dist/
